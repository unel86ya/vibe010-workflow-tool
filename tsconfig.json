{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun-types"],
    "paths": {
      "@workflow-tool/shared": ["./packages/shared/src"],
      "@workflow-tool/shared/*": ["./packages/shared/src/*"],

      "@workflow-tool/workflow": ["./packages/workflow/src"],
      "@workflow-tool/workflow/*": ["./packages/workflow/src/*"]
    }
  },
  "include": [
    "./**/src/**/*.ts",
    "./**/*.d.ts"
  ],
   "exclude": [
    "node_modules",
    "dist"
  ],
}
