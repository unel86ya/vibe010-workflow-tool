{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun-types"],
    "paths": {
      // Копируем пути из корневого tsconfig.json
      "@workflow-tool/shared": ["../../packages/shared/src"],
      "@workflow-tool/shared/*": ["../../packages/shared/src/*"],
      "@workflow-tool/workflow": ["../../packages/workflow/src"],
      "@workflow-tool/workflow/*": ["../../packages/workflow/src/*"]
    }
  }
}